<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="vo_order_boxes">
<interface>
<ic>
<par name="InputDictBoxes" base_type="ctrl" dimension="0"/>
<par name="TypeOrder" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="OutputDictBoxes" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>*Set empty object value to zero </c>
<l>set_system ('store_empty_region','false')</l>
<c>    </c>
<c>*Initialize Output parameters</c>
<l>OutputDictBoxes := dict{}</l>
<c>    </c>
<c>*Oreder using lowest X and lowest Y</c>
<l>if (TypeOrder='mX_mY')</l>
<l>    throw('NotImplementExeception')</l>
<c>    </c>
<c>*Oreder using lowest Y and lowest X    </c>
<l>elseif (TypeOrder='mY_mX')  </l>
<c>    </c>
<l>    restDictBoxes := InputDictBoxes</l>
<l>    get_dict_param (restDictBoxes, 'keys', [], keyBoxes)</l>
<c>    </c>
<l>    numOutBoxes := 0</l>
<c>    </c>
<l>    while (|keyBoxes|&gt;0)</l>
<c>        </c>
<c>        *Get all boxes region</c>
<l>        gen_empty_obj (joinedBoxes)</l>
<l>        for index := 0 to |keyBoxes| - 1 by 1         </l>
<l>            box := restDictBoxes.[index].BoxRegion                </l>
<l>            concat_obj (joinedBoxes, box, joinedBoxes) </l>
<l>        endfor          </l>
<c>        </c>
<c>        *Get all columns and rows points</c>
<l>        region_features (joinedBoxes,'column', ColumnValues)</l>
<l>        region_features (joinedBoxes,'row', RowValues)</l>
<c>        </c>
<c>        *Find region center point with min value to find top box</c>
<l>        tuple_min (RowValues, RowMin)</l>
<l>        tuple_find(RowValues, RowMin, firsPose)</l>
<c>        </c>
<c>        *Get min and max column center point to generata an line</c>
<l>        tuple_min (ColumnValues, ColumnMin)            </l>
<l>        tuple_max (ColumnValues, ColumnMax)</l>
<c>        </c>
<l>        region_features(box, 'height', width)</l>
<c>        </c>
<l>        gen_rectangle1 (Rectangle, RowMin-width/2, ColumnMin, RowMin+width/2, ColumnMax)</l>
<c>        </c>
<l>        lineDictBox := dict{}</l>
<l>        noLineDictBox := dict{}</l>
<l>        lineCurrentIndex := 0</l>
<l>        noLineCurrentIndex := 0</l>
<l>        for Index := 0 to |keyBoxes| - 1 by 1</l>
<l>            ObjectSelected := restDictBoxes.[Index].BoxRegion</l>
<l>            intersection (ObjectSelected, Rectangle, RegionIntersection)</l>
<l>            count_obj (RegionIntersection, isIntersected)</l>
<c>                </c>
<l>            if (isIntersected)                    </l>
<l>                lineDictBox.[lineCurrentIndex] := restDictBoxes.[Index]</l>
<l>                lineCurrentIndex := lineCurrentIndex + 1</l>
<l>            else</l>
<l>                noLineDictBox.[noLineCurrentIndex] := restDictBoxes.[Index]</l>
<l>                noLineCurrentIndex := noLineCurrentIndex + 1</l>
<l>            endif                </l>
<l>        endfor           </l>
<c>        </c>
<c>        *****************************************************************************************</c>
<c>        *-----------------------------------Get top boxes --------------------------------------</c>
<c>        *****************************************************************************************            </c>
<l>        get_dict_param (lineDictBox, 'keys', [], keyLineBoxes)</l>
<c>        </c>
<l>        topLineDictBox := dict{}</l>
<l>        topLineCurrentIndex := 0</l>
<l>        for i := 0 to |keyLineBoxes| - 1 by 1</l>
<l>            areThereAnyUp := false</l>
<c>            </c>
<l>            mainRegion := lineDictBox.[i].BoxRegion</l>
<l>            erosion_rectangle1 (mainRegion, mainRegion, 20, 20)</l>
<l>            dilation_rectangle1 (mainRegion, mainRegion, 1, 100)</l>
<c>            </c>
<l>            for j := 0 to |keyLineBoxes| - 1 by 1</l>
<l>                if (i != j)</l>
<l>                    region := lineDictBox.[j].BoxRegion</l>
<l>                    erosion_rectangle1 (region, region, 20, 20)                    </l>
<l>                    intersection (region, mainRegion, intersectionRegion)</l>
<l>                    count_obj (intersectionRegion, isIntersected)</l>
<c>                    </c>
<l>                    if (isIntersected)</l>
<l>                        region_features(mainRegion, 'row', mainRow)</l>
<l>                        region_features(region,'row', row)</l>
<c>                        </c>
<l>                        if (mainRow &gt; row)</l>
<l>                            areThereAnyUp := true</l>
<l>                        endif</l>
<l>                    endif</l>
<l>                endif</l>
<l>            endfor</l>
<c>            </c>
<l>            if (areThereAnyUp)</l>
<l>                noLineDictBox.[noLineCurrentIndex] := lineDictBox.[i]</l>
<l>                noLineCurrentIndex := noLineCurrentIndex + 1</l>
<l>            else</l>
<l>                topLineDictBox.[topLineCurrentIndex] := lineDictBox.[i]</l>
<l>                topLineCurrentIndex := topLineCurrentIndex + 1</l>
<l>            endif</l>
<c>            </c>
<l>        endfor</l>
<c>        </c>
<c>        **********************************************************************************************************</c>
<c>        *---------------------------------- Update for new Iteration --------------------------------</c>
<c>        ***********************************************************************************************************</c>
<l>        restDictBoxes := noLineDictBox</l>
<l>        get_dict_param (restDictBoxes, 'keys', [], keyBoxes)</l>
<c>        </c>
<c>        **********************************************************************************************************</c>
<c>        *---------------------------------- Oreder the same Y line boxes in X order --------------------------------</c>
<c>        ***********************************************************************************************************</c>
<l>        noOrderedDictBox := topLineDictBox</l>
<l>        get_dict_param (noOrderedDictBox, 'keys', [], keyLineBoxes)</l>
<c>        </c>
<l>        while(|keyLineBoxes| &gt; 0)</l>
<l>            gen_empty_obj (joinedBoxes)</l>
<l>            for index := 0 to |keyLineBoxes| - 1 by 1         </l>
<l>                box := noOrderedDictBox.[index].BoxRegion                </l>
<l>                concat_obj (joinedBoxes, box, joinedBoxes) </l>
<l>            endfor</l>
<c>            </c>
<l>            region_features (joinedBoxes,'column', lineColumnValues)</l>
<l>            tuple_min (lineColumnValues, lineColumnMin)</l>
<l>            tuple_find (lineColumnValues,lineColumnMin, newIndex)</l>
<c>            </c>
<l>            OutputDictBoxes.[numOutBoxes] := noOrderedDictBox.[newIndex]</l>
<l>            numOutBoxes := numOutBoxes + 1</l>
<c>            </c>
<l>            tempDict := dict{}</l>
<l>            tempDictCount := 0</l>
<l>            for index := 0 to |keyLineBoxes| - 1 by 1</l>
<l>                if (newIndex != index)</l>
<l>                    tempDict.[tempDictCount] := noOrderedDictBox.[index]</l>
<l>                    tempDictCount := tempDictCount + 1</l>
<l>                endif</l>
<l>            endfor</l>
<c>            </c>
<l>            noOrderedDictBox := tempDict</l>
<l>            get_dict_param (noOrderedDictBox, 'keys', [], keyLineBoxes)</l>
<c>            </c>
<l>        endwhile</l>
<c>       </c>
<c>            </c>
<l>    endwhile        </l>
<c>        </c>
<l>elseif (TypeOrder='MY_MX')</l>
<c>        </c>
<l>elseif (TypeOrder='MY_MX')    </l>
<c>        </c>
<l>elseif(TypeOrder='top_left')</l>
<c>        </c>
<l>    DictTempBoxes := InputDictBoxes</l>
<c>        </c>
<l>    get_dict_param (DictTempBoxes, 'keys', [], keyBoxes)</l>
<c>        </c>
<l>    gen_empty_obj (TempBoxes)</l>
<c>        </c>
<l>    numOutBoxes := 0        </l>
<c>        </c>
<l>    while (|keyBoxes|&gt;0)            </l>
<c>            </c>
<c>        *Get all boxes region </c>
<l>        for IndexBoxes := 0 to |keyBoxes| - 1 by 1                </l>
<l>            box := DictTempBoxes.[IndexBoxes].BoxRegion                </l>
<l>            concat_obj (TempBoxes, box, TempBoxes)                </l>
<l>        endfor            </l>
<c>            </c>
<c>        *Get all columns and rows points</c>
<l>        region_features (TempBoxes,'column', ColumnValues)</l>
<l>        region_features (TempBoxes,'row', RowValues)</l>
<c>            </c>
<l>        get_dict_param (InputDictBoxes, 'keys', [], keyDictBoxToOrder)</l>
<l>        DictBoxToOrderNumber := |keyDictBoxToOrder|           </l>
<c>            </c>
<l>    endwhile      </l>
<c></c>
<l>    endif</l>
</body>
<docu id="vo_order_boxes">
<parameters>
<parameter id="InputDictBoxes"/>
<parameter id="OutputDictBoxes"/>
<parameter id="TypeOrder"/>
</parameters>
</docu>
</procedure>
</hdevelop>
