<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="vo_check_colision_boxes">
<interface>
<io>
<par name="TopZRegion" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="CandidatesInput" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="CandidatesOutput" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c></c>
<c>****************************************************************</c>
<c>*Check if there are more boxes detected than actually exist.</c>
<c>***************************************************************</c>
<l>try</l>
<l>    get_dict_param (CandidatesInput, 'keys', [], CandidatesInputKeys)</l>
<c>    </c>
<l>    BoxesNumber := |CandidatesInputKeys|</l>
<c></c>
<l>    CandidatesOutput := dict{}</l>
<l>    tempNumCandidate := 0</l>
<c>    </c>
<l>    for CheckIndex := 0 to BoxesNumber - 1 by 1</l>
<c>        </c>
<l>        WorkObject := CandidatesInput.[CheckIndex].BoxRegion</l>
<c>        </c>
<l>        region_features (WorkObject, 'area', WorkObjectArea)</l>
<c>        </c>
<l>        min_intersection_area:=WorkObjectArea/5</l>
<c>        </c>
<l>        is_ok:=true</l>
<c>        </c>
<c>        *If there is any box intersection with the current box (WorkObject), remove it from FindBoxes if its score is less than that of the intersecting box</c>
<l>        for CheckIndex2 := 0 to BoxesNumber - 1 by 1</l>
<c>            </c>
<l>            if (CheckIndex != CheckIndex2)                                  //Used to don't analize same box</l>
<l>*                 select_obj (FindBoxesOut, ObjectToCheck, CheckIndex2)</l>
<l>                ObjectToCheck := CandidatesInput.[CheckIndex2].BoxRegion</l>
<c>                </c>
<l>                intersection (WorkObject,ObjectToCheck, RegionIntersection)</l>
<c>                </c>
<l>                union1 (RegionIntersection,RegionIntersection)</l>
<c>                </c>
<l>                region_features (RegionIntersection, 'area', Value)</l>
<c>                </c>
<c>                </c>
<c>                </c>
<l>                if (Value&gt;min_intersection_area)</l>
<c>                    </c>
<c>                    *Check better score</c>
<c>                    </c>
<l>                    if (CandidatesInput.[CheckIndex].Score&lt;CandidatesInput.[CheckIndex2].Score)</l>
<l>                        is_ok:=false</l>
<l>*                         stop()</l>
<l>                    endif</l>
<l>                endif</l>
<c>                </c>
<c>                *Check if the box is outside of the Layer region</c>
<l>                difference (WorkObject, TopZRegion, RegionOutTopRegion)</l>
<l>                region_features (RegionOutTopRegion, 'area', AreaOutTopRegion)</l>
<l>                if(AreaOutTopRegion &gt; min_intersection_area)</l>
<c>                    </c>
<l>                    is_ok := false</l>
<c>                    </c>
<l>                endif</l>
<c>                </c>
<l>                if(not is_ok)</l>
<l>                    break</l>
<l>                endif</l>
<c>                </c>
<l>            endif   </l>
<l>        endfor</l>
<c>        </c>
<l>        if (is_ok)</l>
<c>            </c>
<l>            CandidatesOutput.[tempNumCandidate] := CandidatesInput.[CheckIndex]</l>
<l>*             concat_obj (FindBoxesTemp,WorkObject,FindBoxesTemp)</l>
<l>            tempNumCandidate := tempNumCandidate + 1</l>
<l>        endif</l>
<c>        </c>
<l>    endfor</l>
<c>    </c>
<l>catch (Ex)</l>
<c></c>
<l>    OutputDict.Error.General := 'Checking if there are collision boxes'</l>
<l>    OutputDict.Error.Exception := Ex</l>
<l>    stop()</l>
<l>    return ()</l>
<c>    </c>
<l>endtry</l>
<c></c>
<l>try</l>
<c>    </c>
<c>    *Set a box order</c>
<l>    vo_order_boxes (CandidatesOutput, 'mY_mX', CandidatesInput)</l>
<c>    </c>
<c>    *Get all boxes region </c>
<l>    get_dict_param (CandidatesInput, 'keys', [], keysCandidates)</l>
<c>    </c>
<l>    gen_empty_obj (TempFindBoxes)</l>
<c>    </c>
<l>    for IndexCandidates := 0 to |keysCandidates|-1 by 1</l>
<c>        </c>
<l>        concat_obj (TempFindBoxes, CandidatesInput.[IndexCandidates].BoxRegion, TempFindBoxes)</l>
<c>        </c>
<l>    endfor</l>
<c>    </c>
<l>    FindBoxesOut := TempFindBoxes</l>
<c>    </c>
<c>    </c>
<l>catch (Ex)</l>
<c>    </c>
<l>    OutputDict.Error.General := 'Arranging Boxes'</l>
<l>    OutputDict.Error.Exception := Ex</l>
<l>    stop()</l>
<l>    return ()</l>
<c>    </c>
<l>endtry</l>
<l>return ()</l>
</body>
<docu id="vo_check_colision_boxes">
<parameters>
<parameter id="CandidatesInput"/>
<parameter id="CandidatesOutput"/>
<parameter id="TopZRegion"/>
</parameters>
</docu>
</procedure>
</hdevelop>
