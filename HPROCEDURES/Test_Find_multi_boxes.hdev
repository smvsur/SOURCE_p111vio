<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c></c>
<c>**********************************************************************************************************</c>
<c>*</c>
<c>*                                             Read Recipes</c>
<c>*</c>
<c>**********************************************************************************************************</c>
<l>read_dict ( 'C:/Users/LeonardoNahuel/OneDrive - Vision OnLine GmbH/Dokumente - España/Proyectos/KH7/Ampliación_multi_referencia/Recipes/12BOT750ml.hdict', [], [], RecipeMain)</l>
<l>read_dict ('C:/Users/LeonardoNahuel/OneDrive - Vision OnLine GmbH/Dokumente - España/Proyectos/KH7/Ampliación_multi_referencia/Recipes/5LSTD.hdict', [], [], RecipeSecondary)</l>
<c></c>
<c></c>
<c></c>
<c>**********************************************************************************************************</c>
<c>*</c>
<c>*                                             Test model</c>
<c>*</c>
<c>**********************************************************************************************************</c>
<c></c>
<c></c>
<l>list_image_files ('C:/Users/LeonardoNahuel/OneDrive - Vision OnLine GmbH/Desktop/work/In Working/kh7/Fallos/Fallos mayo/12BOT750ml', 'hobj', [], ImageFiles) </l>
<l>* list_image_files ('C:/Users/LeonardoNahuel/OneDrive - Vision OnLine GmbH/Dokumente - España/Proyectos/KH7/Palletizer_with_Recipe_Manager/Halcon Images/KH7', 'hobj', [], ImageFiles) </l>
<l>* list_image_files ('C:/Users/LeonardoNahuel/OneDrive - Vision OnLine GmbH/Dokumente - España/Proyectos/KH7/Palletizer_with_Recipe_Manager/Halcon Images/KH7-Linea', 'hobj', [], ImageFiles) </l>
<c></c>
<c></c>
<c></c>
<c></c>
<c></c>
<c>*Add second recipe</c>
<l>* RecipeMain.SecondRecipe := dict{}</l>
<l>* RecipeMain.SecondRecipe.Name := '5LSTD'</l>
<l>* RecipeMain.SecondRecipe.Recipe := RecipeSecondary</l>
<c></c>
<c></c>
<l>read_dict ('C:/Users/LeonardoNahuel/OneDrive - Vision OnLine GmbH/Dokumente - España/Proyectos/KH7/Palletizer_with_Recipe_Manager/Backups/Debug_BK20250506/Debug_BK20250506/DATA/RECIPES/12BOT750ml.hdict', [], [], RecipeMain)</l>
<c></c>
<l>RecipeMain.TrainDict.GetTopROI.DeltaZ := 200</l>
<c></c>
<c></c>
<l>for Index := 0 to |ImageFiles|-1 by 1</l>
<c>    </c>
<l>    try</l>
<l>        InputDict := dict{}</l>
<l>        InputDict.RecipeDict := RecipeMain</l>
<l>        InputDict.RobotPose := dict{}</l>
<l>        create_pose (520, 515,3060, 180, -90, 0, 'Rp+T', 'abg', 'point', RobotPose)</l>
<c>        </c>
<l>        InputDict.RobotPose.BaseHTool := RobotPose</l>
<c>        </c>
<l>*         read_pose ('../CALIBRATION/toolHcam.dat', ToolHCam)</l>
<c>        </c>
<l>*         InputDict.RobotPose.ToolHCam := ToolHCam</l>
<c>        </c>
<c>        </c>
<l>        read_object (ObjectToTest, ImageFiles[Index])</l>
<l>        select_obj (ObjectToTest, ObjectSelected1, 1)</l>
<l>        InputDict.DepthMap := ObjectSelected1</l>
<l>        select_obj (ObjectToTest, ObjectSelected, 2)</l>
<l>        InputDict.InputImage := ObjectSelected</l>
<c>        </c>
<l>        vo_find_multi_boxes (InputDict, OutputDict)</l>
<c>        </c>
<l>        gen_empty_obj (t)</l>
<l>        t := OutputDict.ImageResult</l>
<c>        </c>
<l>*         wait_seconds(1)</l>
<c>        </c>
<l>        stop()</l>
<l>    catch(Ex)</l>
<l>        stop()</l>
<l>    endtry</l>
<c></c>
<c>    </c>
<l>*     write_dict (OutputDict,'./Recipes/KH7-linea.hdict', [], [])</l>
<c>    </c>
<l>endfor</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
