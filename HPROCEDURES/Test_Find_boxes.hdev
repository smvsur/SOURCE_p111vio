<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<l>* RecipeName := 'KH7'</l>
<l>* RecipeName := 'Little-Logo'</l>
<l>* RecipeName := '5LSTD'</l>
<l>* RecipeName := 'Marron_1'</l>
<l>* RecipeName := '6PROMO780ml'</l>
<l>* RecipeName := '12BOT750ml'</l>
<l>RecipeName := '12BOT500ml'</l>
<l>* RecipeName := '12BOT750mlB1'</l>
<c></c>
<c></c>
<c>**********************************************************************************************************</c>
<c>*</c>
<c>*                                             Read Recipe</c>
<c>*</c>
<c>**********************************************************************************************************</c>
<l>read_dict ('../RECIPES/' + RecipeName + '.hdict', [], [], DictHandle)</l>
<c></c>
<c>**********************************************************************************************************</c>
<c>*</c>
<c>*                                             Test model</c>
<c>*</c>
<c>**********************************************************************************************************</c>
<c></c>
<l>list_image_files ('../IMAGES/' + RecipeName, 'hobj', [], ImageFiles) </l>
<c></c>
<c></c>
<c>*Manipulate recipe</c>
<c></c>
<l>TrainDict := DictHandle.TrainDict</l>
<c></c>
<c>*Save on dict recipe</c>
<c></c>
<l>DictHandle.TrainDict := TrainDict</l>
<c></c>
<l>for Index := 0 to |ImageFiles|-1 by 1</l>
<c>    </c>
<l>    try</l>
<l>        InputDict := dict{}</l>
<l>        InputDict.RecipeDict := DictHandle</l>
<l>        InputDict.RobotPose := dict{}</l>
<l>        create_pose (520, 515,3060, 180, -90, 0, 'Rp+T', 'abg', 'point', RobotPose)</l>
<c>        </c>
<l>        InputDict.RobotPose.BaseHTool := RobotPose</l>
<c>        </c>
<l>        read_pose ('../CALIBRATION/toolHcam.dat', ToolHCam)</l>
<c>        </c>
<l>        InputDict.RobotPose.ToolHCam := ToolHCam</l>
<c>        </c>
<c>        </c>
<l>        read_object (ObjectToTest, ImageFiles[Index])</l>
<l>        select_obj (ObjectToTest, ObjectSelected1, 1)</l>
<l>        InputDict.DepthMap := ObjectSelected1</l>
<l>        select_obj (ObjectToTest, ObjectSelected, 2)</l>
<l>        InputDict.InputImage := ObjectSelected</l>
<c>        </c>
<l>        vo_find_boxes (InputDict, OutputDict)</l>
<c>        </c>
<l>        gen_empty_obj (i)</l>
<c>        </c>
<l>        i := OutputDict.ImageResult</l>
<c>        </c>
<l>        dev_display(OutputDict.ImageResult)</l>
<c>        </c>
<l>*         wait_seconds(1)</l>
<c>        </c>
<l>        stop()</l>
<l>    catch(Ex)</l>
<l>        stop()</l>
<l>    endtry</l>
<c></c>
<c>    </c>
<l>*     write_dict (OutputDict,'./Recipes/KH7-linea.hdict', [], [])</l>
<c>    </c>
<l>endfor</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
